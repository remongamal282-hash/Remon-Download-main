{
  "name": "remon-download",
  "productName": "Remon Download",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:runtime": "node scripts/check-runtime.mjs",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron/electron --sourcemap --out-extension:.js=.cjs",
    "electron:start": "npm run build && npm run electron:build && electron .",
    "dist:win": "npm run check:runtime && npm run build && npm run electron:build && electron-builder --win portable",
    "dist:win:installer": "npm run check:runtime && npm run build && npm run electron:build && electron-builder --win nsis",
    "electron:dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\" -n \"VITE,ELECTRON\" -c \"blue,green\"",
    "dev:vite": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$port = 5173; $connections = Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue; if ($connections) { foreach ($connection in $connections) { try { Stop-Process -Id $connection.OwningProcess -Force -ErrorAction Stop } catch {} } }; vite --port 5173\"",
    "dev:electron": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$port = 5173; $connections = Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue; if ($connections) { foreach ($connection in $connections) { try { Stop-Process -Id $connection.OwningProcess -Force -ErrorAction Stop } catch {} } }; wait-on http://localhost:5173; npm run electron:build; cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@hookform/resolvers": "^3.9.0",
    "i18next": "^23.15.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^7.18.3",
    "sonner": "^1.5.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.remon.download",
    "productName": "Remon Download",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-electron/electron",
        "to": "dist-electron/electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "icon.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "executableName": "Remon Download",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Remon-Download-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remon Download",
      "artifactName": "Remon-Download-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
