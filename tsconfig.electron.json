{
  "compilerOptions": {
    "composite": false,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist-electron",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": false
  },
  "include": ["electron/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron", "src/**/*.test.*"]
}
